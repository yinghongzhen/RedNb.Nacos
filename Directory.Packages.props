<Project>
  <PropertyGroup><ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally></PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FluentAssertions" Version="8.3.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="FluentAssertions" Version="8.3.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Google.Protobuf" Version="3.33.3" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Google.Protobuf" Version="3.33.3" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.76.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.76.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Grpc.Tools" Version="2.76.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Grpc.Tools" Version="2.76.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.21.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Agents.AI.A2A" Version="1.21.0-preview.260911.1" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.1" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.1" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.1" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Moq" Version="4.20.72" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Moq" Version="4.20.72" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="WireMock.Net" Version="2.15.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="WireMock.Net" Version="2.15.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" Condition="'$(TargetFramework)' == 'net8.0'" />
    <!-- xUnit.net v3; keep VSTest/TRX/coverlet rather than enabling MTP implicitly. -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>


