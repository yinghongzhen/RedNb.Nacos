<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <InternalsVisibleTo Include="RedNb.Nacos.Http" />
    <InternalsVisibleTo Include="RedNb.Nacos.Grpc" />
    <InternalsVisibleTo Include="RedNb.Nacos.AspNetCore" />
    <InternalsVisibleTo Include="RedNb.Nacos.Tests" />
    <InternalsVisibleTo Include="RedNb.Nacos.Sample.Aot" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Description>Nacos .NET SDK - Core abstractions, models and interfaces for Nacos client</Description>
    <PackageTags>nacos;service-discovery;config;microservices;abstractions</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
</Project>
